{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.roku",
  "version": "0.1.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Roku"
  },
  "description": {
    "en": "Control your Roku TVs and Roku Streaming Players via External Control Protocol (ECP)."
  },
  "category": [
    "video"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Roku Homey Developer"
  },
  "brandColor": "#662D91",
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "App changed"
        },
        "titleFormatted": {
          "en": "Active app changed"
        },
        "hint": {
          "en": "Triggers when the currently running app or channel changes on the Roku device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=roku"
          }
        ],
        "tokens": [
          {
            "name": "app_name",
            "type": "string",
            "title": {
              "en": "App Name"
            },
            "example": {
              "en": "Netflix"
            }
          },
          {
            "name": "app_id",
            "type": "string",
            "title": {
              "en": "App ID"
            },
            "example": {
              "en": "12"
            }
          }
        ],
        "id": "app_changed"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "App !{{is|isn't}} running"
        },
        "titleFormatted": {
          "en": "App [[app]] !{{is|isn't}} running"
        },
        "hint": {
          "en": "Checks whether a specific app/channel is currently active on the Roku device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=roku"
          },
          {
            "type": "autocomplete",
            "name": "app",
            "title": {
              "en": "App"
            },
            "placeholder": {
              "en": "Select an app (e.g. Netflix)"
            }
          }
        ],
        "id": "app_is_running"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Launch app"
        },
        "titleFormatted": {
          "en": "Launch app [[app]]"
        },
        "hint": {
          "en": "Directly launches an installed Roku channel or app."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=roku"
          },
          {
            "type": "autocomplete",
            "name": "app",
            "title": {
              "en": "App"
            },
            "placeholder": {
              "en": "Select an app (e.g. YouTube)"
            }
          }
        ],
        "id": "launch_app"
      },
      {
        "title": {
          "en": "Send remote key"
        },
        "titleFormatted": {
          "en": "Send remote key [[key]]"
        },
        "hint": {
          "en": "Sends an ECP remote control keypress to the Roku device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=roku"
          },
          {
            "type": "dropdown",
            "name": "key",
            "title": {
              "en": "Key"
            },
            "values": [
              {
                "id": "Home",
                "title": {
                  "en": "Home"
                }
              },
              {
                "id": "Back",
                "title": {
                  "en": "Back"
                }
              },
              {
